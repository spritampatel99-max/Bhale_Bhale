# Copy this file to ".env" and edit it. NEVER commit the real .env file.
# Local development works without a .env file at all.

# Set to False for any real deployment.
DJANGO_DEBUG=True

# REQUIRED when DJANGO_DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Comma separated host names, e.g. novamart.example.com,www.novamart.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma separated origins (with scheme) when serving over HTTPS, e.g. https://novamart.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Demo accounts (10 customers + 1 admin) are only created when this is True.
# Defaults to the value of DJANGO_DEBUG. Keep it False in production.
NOVAMART_ALLOW_DEMO_ACCOUNTS=True

# Delivery rules (INR)
NOVAMART_DELIVERY_FEE=49
NOVAMART_FREE_DELIVERY_THRESHOLD=999

# --- Optional PostgreSQL (not needed for the prototype; also: pip install psycopg[binary]) ---
# DB_ENGINE=postgresql
# DB_NAME=novamart
# DB_USER=novamart
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
